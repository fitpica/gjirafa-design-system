      "disabled": {
        "$type": "color",
        "$value": "{color.neutral.60}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-text-disabled",
            "scss": "$color-neutral-60"
          }
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.neutral.80}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-text-placeholder",
            "scss": "$color-neutral-80"
          }
        }
      },
      "label": {
        "$type": "color",
        "$value": "{color.neutral.400}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-text-label",
            "scss": "$color-neutral-400"
          }
        }
      },
      "helper": {
        "$type": "color",
        "$value": "{color.neutral.90}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-text-helper",
