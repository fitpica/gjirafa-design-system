        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-border-default",
            "scss": "$color-neutral-40"
          }
        }
      },
      "strong": {
        "$type": "color",
        "$value": "{color.neutral.80}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-border-strong",
            "scss": "$color-neutral-80"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$value": "{color.blue.500}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-border-focus",
            "scss": "$color-blue-500"
          }
        }
