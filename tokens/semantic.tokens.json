            "scss": "$color-green-700"
          }
        }
      },
      "warning": {
        "$type": "color",
        "$value": "{color.orange.600}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-warning",
            "scss": "$color-orange-600"
          }
        }
