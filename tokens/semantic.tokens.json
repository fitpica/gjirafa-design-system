      "warning-text": {
        "$type": "color",
        "$value": "{color.orange.700}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-warning-text",
            "scss": "$color-orange-700"
          }
        }
      }
