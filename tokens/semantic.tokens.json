{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "GDS semantic tokens, default theme (codex). Aliases point at foundation tokens. Generated from src/tokens/_semantic.scss.",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "{color.blue.500}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-brand-primary",
            "scss": "$color-blue-500"
          }
        }
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.blue.500}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-action-primary",
            "scss": "$color-blue-500"
          }
        }
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{color.blue.600}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-action-primary-hover",
            "scss": "$color-blue-600"
          }
        }
      },
      "primary-active": {
        "$type": "color",
        "$value": "{color.blue.700}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-action-primary-active",
            "scss": "$color-blue-700"
          }
        }
      },
      "on-primary": {
        "$type": "color",
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-action-on-primary",
            "scss": "$color-neutral-0"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.neutral.700}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-text-primary",
            "scss": "$color-neutral-700"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.neutral.300}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-text-secondary",
            "scss": "$color-neutral-300"
          }
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.neutral.80}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-text-tertiary",
            "scss": "$color-neutral-80"
          }
        }
