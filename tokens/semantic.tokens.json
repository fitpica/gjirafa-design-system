      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.30}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-border-subtle",
            "scss": "$color-neutral-30"
          }
        }
      }
    },
    "feedback": {
      "error": {
        "$type": "color",
        "$value": "{color.red.500}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-error",
            "scss": "$color-red-500"
          }
        }
      },
      "error-text": {
        "$type": "color",
        "$value": "{color.red.700}",
