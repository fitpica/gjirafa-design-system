        "$type": "color",
        "$value": "{color.neutral.0}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-bg-primary",
            "scss": "$color-neutral-0"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.neutral.20}",
        "$extensions": {
          "com.gjirafa.gds": {
            "cssVar": "--gds-color-bg-secondary",
